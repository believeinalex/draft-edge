{
  "manifest_version": 3,
  "name": "Draft Edge Live Sync",
  "version": "0.1.0",
  "description": "Watches a live Yahoo Fantasy Basketball auction draft and overlays budget, inflation, and value-pick recommendations from the Draft Edge model in real time.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.fantasysports.yahoo.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.fantasysports.yahoo.com/*"],
      "js": ["players.js", "engine.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
